[Unit]
Description=Mario Kart Board Game (Node.js + Socket.IO)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/mario-kart-board
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=BASE_PATH=/mario
Environment=TURN_SECONDS=45
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
# 基本隔離
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
